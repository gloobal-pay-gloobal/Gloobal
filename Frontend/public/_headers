# Deployment security headers (Netlify / Cloudflare Pages read this file
# automatically from the build output root). The <meta> CSP tag in
# index.html is a baseline that works everywhere; real HTTP headers here
# are stronger and also add the protections a <meta> tag can't express
# (X-Frame-Options, HSTS, Permissions-Policy, etc). Adjust CSP if you add
# a real backend/API origin.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://logo.clearbit.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://logo.clearbit.com https://gloobal-pay.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

# The service worker itself must never be cached by an intermediate cache
# or the browser's own HTTP cache — the browser needs to re-check it on
# every load to notice updates in a timely way. Everything else in
# /assets/ is content-hashed and safe to cache forever.
/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable
